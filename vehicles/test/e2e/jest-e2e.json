{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../",
  "roots": [
    "<rootDir>/src",
    "<rootDir>/test"
  ],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(uuid)/)"
  ], 
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/src/$1",
    "^@modules/(.*)$": "<rootDir>/src/modules/$1",
    "^@common/(.*)$": "<rootDir>/src/common/$1"
  }
}
